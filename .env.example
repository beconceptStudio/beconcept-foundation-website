# Rate limit del modulo (Upstash Redis via Vercel Marketplace: imposta KV_REST_API_URL / KV_REST_API_TOKEN).
# Se mancano, si usa un limite in memoria per singola istanza.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
